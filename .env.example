# Copy to .env on the server and fill in. NEVER commit the real .env
PYTHON_BIN=/opt/ocr/venv/bin/python
DISPATCHER_SCRIPT=/opt/ocr/main_dispatcher.py
INPUT_DIR=/data/pdfs/new
STATE_FILE=/var/lib/ocr/dispatcher_state.json
ES_HOST=https://ES_HOST_PLACEHOLDER:9200
ES_INDEX=all_extractor
ES_USER=elastic
ES_PASSWORD=CHANGE_ME
ES_CA_CERT=/etc/logstash/certs/http_ca.crt
OCR_LANG=ara+eng
OCR_DPI=250
