# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets
.env
*.env
!.env.example
*.key
*.pem
*.p12
credentials*
secrets*

# Input documents (private)
data/
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.tif
*.tiff
*.jpg
*.jpeg
# Evaluation samples are regenerated by evaluation/make_samples.py (seeded);
# only truth/, manifest.json and queries.csv are committed.
evaluation/samples/*
!evaluation/samples/truth/
!evaluation/samples/.gitkeep

# OCR output / runtime state  (NOTE: do NOT ignore *.txt - requirements.txt is needed)
ocr_results/
.dispatcher_state.json
evaluation/results/*.jsonl

# Logs
*.log
logs/

# Elasticsearch / Logstash runtime data
elasticsearch/data/
logstash/data/
logstash/logs/

# JVM / heap dumps
*.hprof

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
